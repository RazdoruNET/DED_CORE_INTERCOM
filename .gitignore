# Локальный стенд: сертификаты, приватные ключи, тестовые скрипты и venv.
# Каталог не публикуется ни в каком виде — здесь лежат ca.key, server.key,
# signing.key, prod-signing.key, oidc.key.pem и код привязки стенда.
.dev/

# Секреты конкретной сборки: доверенный CA платформы и закреплённый ключ
# подписи привязки. Шаблон — firmware/src/config/Trust.example.h.
firmware/src/config/Secrets.h

# PlatformIO: собранные образы, карта прошивки и скачанные библиотеки.
firmware/.pio/
.pio/

# Ключи и сертификаты в любом месте дерева: случайно добавленный файл не должен
# уехать в публичный репозиторий.
*.pem
*.key
*.crt
*.pfx
*.p12
*.token
*.der

# Собранные образы прошивки: публикуются в разделе DIY и в релизах, но не
# коммитятся в дерево — в git лежит только исходник, из которого они собраны.
*.bin
*.elf

# Мусор ОС: не должен уезжать в публичный репозиторий
.DS_Store
Thumbs.db
